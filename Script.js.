@import url("https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Manrope:wght@400;500&display=swap");

:root {
  --ink: #4e5141;
  --sage: #69745a;
  --gold: #a0804b;
  --paper: #f7f5ed;

  --floral: url("data:image/webp;base64,");
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  color: var(--ink);
  background:
    linear-gradient(#f7f4e780, #f7f4e780),
    var(--floral) center / cover fixed;
  font: 14px/1.8 Manrope, Arial, sans-serif;
}

body.locked {
  overflow: hidden;
}

[hidden] {
  display: none !important;
}

button,
input,
select {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
}

button {
  cursor: pointer;
}

button:focus-visible,
a:focus-visible,
input:focus-visible,
select:focus-visible {
  outline: 2px solid var(--sage);
  outline-offset: 4px;
}

h1,
h2,
p,
figure {
  margin: 0;
}

h1,
h2,
.signature,
.month,
.cover-footer p {
  font-family: "Cormorant Garamond", Georgia, serif;
  font-weight: 400;
}

h2 {
  font-size: clamp(35px, 9vw, 48px);
  line-height: 1.15;
  letter-spacing: -.025em;
}

.eyebrow {
  color: var(--sage);
  font-size: 10px;
  font-weight: 500;
  line-height: 1.7;
  letter-spacing: .18em;
  text-transform: uppercase;
}

/* КОНВЕРТ */
.cover {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  justify-content: center;
  overflow: hidden;
  background: transparent;
  transition: opacity .5s ease 1s;
}

.envelope {
  position: relative;
  width: 100%;
  max-width: 580px;
  height: 100%;
  min-height: 530px;
  isolation: isolate;
}

.envelope-top,
.envelope-bottom {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(#faf8ef38, #faf8ef38),
    var(--floral) center / cover;
  transition: transform 1.6s cubic-bezier(.65, 0, .2, 1);
}

.envelope-top {
  z-index: 2;
  clip-path: polygon(
    0 0, 100% 0, 100% 43%,
    92% 44%, 86% 47%, 76% 48%,
    66% 50%, 58% 53%, 50% 54%,
    42% 53%, 34% 50%, 24% 48%,
    14% 47%, 8% 44%, 0 43%
  );
}

.envelope-bottom {
  z-index: 1;
  clip-path: polygon(
    0 42%, 8% 43%, 14% 46%,
    24% 47%, 34% 49%, 42% 52%,
    50% 53%, 58% 52%, 66% 49%,
    76% 47%, 86% 46%, 92% 43%,
    100% 42%, 100% 100%, 0 100%
  );
}

.cover-heading {
  position: absolute;
  top: 18%;
  left: 7%;
  right: 7%;
  z-index: 3;
  text-align: center;
  transition: transform 1s ease, opacity .6s ease;
}

.cover-heading h1 {
  margin-top: 23px;
  color: #4e5340;
  font-size: clamp(47px, 13vw, 69px);
  font-style: italic;
  line-height: .98;
  letter-spacing: -.035em;
}

.cover-heading h1 span {
  color: var(--gold);
  font-size: .55em;
}

.cover-date {
  margin-top: 25px;
  font: 18px "Cormorant Garamond", Georgia, serif;
  letter-spacing: .06em;
}

.seam {
  position: absolute;
  top: 40%;
  left: 0;
  z-index: 3;
  width: 100%;
  height: 18%;
  overflow: visible;
  transition: opacity .5s ease;
}

.seam path {
  fill: none;
  stroke: #989d80;
  stroke-width: 1;
}

.seam path + path {
  stroke: #fffdf4;
  stroke-width: 1.5;
}

.seal {
  position: absolute;
  top: 51%;
  left: 50%;
  z-index: 5;
  display: grid;
  place-items: center;
  width: 108px;
  height: 108px;
  padding: 0;
  border: 2px solid #bd985d;
  border-radius: 47% 51% 48% 50%;
  transform: translate(-50%, -50%) rotate(-8deg);
  color: #9a7038;
  background: radial-gradient(
    circle at 32% 20%,
    #f4dba1,
    #d4ad6d 27%,
    #b98c49 55%,
    #d8b374 76%,
    #916732
  );
  box-shadow:
    0 7px 10px #47362245,
    inset 0 0 0 7px #e5c184,
    inset 0 0 0 9px #a97d42,
    inset 0 0 0 11px #efd09a;
  transition: transform .7s ease, opacity .6s ease;
}

.seal > span {
  padding-right: 6px;
  font: italic 37px "Cormorant Garamond", Georgia, serif;
  letter-spacing: -.13em;
  text-shadow: -1px -1px #f5dba7, 1px 1px #93682e;
}

.seal-and {
  font-size: 22px;
}

.cover-footer {
  position: absolute;
  top: 68%;
  left: 8%;
  right: 8%;
  z-index: 3;
  text-align: center;
  transition: transform 1s ease, opacity .6s ease;
}

.cover-footer p {
  font-size: 28px;
  line-height: 1.12;
}

.cover-footer em {
  font-size: 32px;
}

.open-button {
  display: block;
  min-height: 44px;
  margin: 24px auto 0;
  padding: 10px 0;
  border: 0;
  border-bottom: 1px solid #919777;
  color: #505940;
  background: #faf8ef60;
  font-size: 11px;
}

.cover-footer small {
  display: block;
  margin-top: 12px;
  color: #697158;
  font-size: 9px;
}

.cover.opening {
  opacity: 0;
  pointer-events: none;
}

.opening .envelope-top {
  transform: translateY(-70%) rotate(-4deg);
}

.opening .envelope-bottom {
  transform: translateY(70%) rotate(4deg);
}

.opening .cover-heading {
  transform: translateY(-90px);
  opacity: 0;
}

.opening .cover-footer {
  transform: translateY(90px);
  opacity: 0;
}

.opening .seam {
  opacity: 0;
}

.opening .seal {
  transform: translate(-50%, -50%) rotate(15deg) scale(1.4);
  opacity: 0;
}

/* МУЗЫКА */
.music-button {
  position: fixed;
  top: 15px;
  right: 15px;
  z-index: 110;
  min-height: 44px;
  padding: 9px 14px;
  border: 1px solid #cdd0bb;
  border-radius: 30px;
  color: #596149;
  background: #faf9eff0;
  font-size: 11px;
}

/* СТРАНИЦА */
main {
  max-width: 580px;
  margin: auto;
  overflow: hidden;
  background:
    linear-gradient(#fbfaf4e8, #fbfaf4e8),
    var(--floral) top center / 100% auto repeat-y;
}

.hero {
  padding: 75px 28px 35px;
  text-align: center;
  background:
    linear-gradient(#fffdf9a0, #fffdf990),
    var(--floral) center / cover;
}

.hero h1 {
  margin: 22px -12px 0;
  font-size: clamp(37px, 10.6vw, 60px);
  font-style: italic;
  line-height: 1.08;
  letter-spacing: -.04em;
}

.hero h1 span {
  color: var(--gold);
  font-size: .7em;
}

.hero-subtitle {
  margin: 13px 0 30px;
  color: #697158;
  font-size: 10px;
}

.portrait {
  max-width: 380px;
  margin: auto;
  padding: 8px;
  border: 1px solid #a7ad8e;
  border-radius: 220px 220px 4px 4px;
  background: #fffdf58c;
}

.portrait img {
  display: block;
  width: 100%;
  height: auto;
  border-radius: inherit;
}

.hero-date {
  margin-top: 28px;
  font: 26px "Cormorant Garamond", Georgia, serif;
  letter-spacing: .12em;
}

.down {
  display: inline-grid;
  place-items: center;
  width: 44px;
  height: 44px;
  margin-top: 12px;
  color: #727d5c;
  font-size: 25px;
  text-decoration: none;
}

.section {
  padding: 56px 28px;
  text-align: center;
}

.section h2 {
  max-width: 430px;
  margin: 15px auto 25px;
}

.section p {
  max-width: 430px;
  margin: 15px auto;
}

.welcome {
  padding-top: 48px;
}

.intro {
  font: 22px/1.7 "Cormorant Garamond", Georgia, serif;
}

.signature {
  color: #7d805f;
  font-size: 30px;
  font-style: italic;
}

/* КАЛЕНДАРЬ НА ФОТО РУК */
.calendar-section {
  padding: 43px 25px;
  text-align: center;
  background:
    linear-gradient(#f9f7ed70, #f9f7ed65),
    url("https://i.ibb.co/nsR9GGM9/571A3302.jpg")
    center 51% / cover;
}

.calendar-section h2 {
  margin: 15px 0 27px;
}

.calendar {
  max-width: 342px;
  margin: auto;
  padding: 23px 14px 19px;
  border: 1px solid #e0ddc6a6;
  background: #fffdf2ac;
}

.month {
  font-size: 38px;
  font-style: italic;
}

.year {
  margin: 5px 0 25px;
  color: #7d8163;
  font-size: 11px;
  letter-spacing: .2em;
}

.week,
.days {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 5px;
}

.week {
  margin-bottom: 13px;
  color: #596149;
  font-size: 9px;
}

.days > span,
.days > button {
  display: grid;
  place-items: center;
  aspect-ratio: 1;
  min-width: 0;
  padding: 0;
  color: #343c2b;
  font: 22px "Cormorant Garamond", Georgia, serif;
}

.days > button {
  border: 1px solid #9b855f;
  border-radius: 50%;
  color: #fffdf4;
  background: #7d8868;
  box-shadow: 0 0 0 4px #919e7922;
}

.calendar-caption {
  display: inline-block;
  margin-top: 25px;
  padding: 4px 10px;
  color: #4b533d;
  background: #fbf8ecb0;
  font-size: 10px;
}

/* ОТСЧЁТ */
.countdown {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  max-width: 410px;
  margin: 27px auto 0;
}

.countdown div + div {
  border-left: 1px solid #c5c9ae;
}

.countdown strong {
  display: block;
  color: #677253;
  font: 45px/1 "Cormorant Garamond", Georgia, serif;
  font-variant-numeric: tabular-nums;
}

.countdown small {
  display: block;
  margin-top: 12px;
  color: #727b61;
  font-size: 9px;
}

/* ПРОГРАММА */
.program {
  border-block: 1px solid #d5d8c4;
  background: #e9eddfb0;
}

.timeline {
  max-width: 370px;
  margin: 35px auto 0;
  text-align: left;
}

.timeline > div {
  display: grid;
  grid-template-columns: 70px 1fr;
  gap: 25px;
  padding: 17px 0;
  border-bottom: 1px solid #c7ceb766;
}

.timeline time {
  color: #777f5c;
  font: 28px "Cormorant Garamond", Georgia, serif;
}

.timeline span {
  align-self: center;
  font-size: 12px;
}

/* КНОПКИ */
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 49px;
  margin-top: 23px;
  padding: 13px 23px;
  border: 1px solid #889171;
  border-radius: 2px;
  color: var(--ink);
  background: #faf9efb0;
  text-align: center;
  text-decoration: none;
}

.venue {
  background: #e6ebded4;
}

.venue p {
  margin: 7px auto;
}

/* ФОТО СЕМЬИ */
.family-photo {
  margin: 0 28px;
  padding: 7px;
  border: 1px solid #d2d2bd;
  border-radius: 120px 120px 3px 3px;
  background: #fffdf5;
}

.family-photo img {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 113px 113px 0 0;
}

/* ФОРМА */
form {
  max-width: 390px;
  margin: 30px auto 0;
  text-align: left;
}

label {
  display: block;
  margin: 20px 0 8px;
  font-size: 11px;
}

input,
select {
  width: 100%;
  min-height: 49px;
  padding: 12px;
  border: 1px solid #bcc3a8;
  border-radius: 2px;
  color: var(--ink);
  background: #fdfcf8e6;
  font-size: 16px;
}

input:disabled {
  opacity: .5;
}

form .button {
  width: 100%;
  color: white;
  background: #7b8666;
}

form .button:hover {
  color: white;
  background: #657352;
}

.form-hint,
#formStatus {
  text-align: center;
  font-size: 11px;
}

/* ТЕЛЕФОНЫ */
.contacts {
  background: #e7ebdab0;
}

.contact {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  max-width: 420px;
  margin: auto;
  padding: 22px 0;
  border-top: 1px solid #b9c0a3;
  color: var(--ink);
  text-align: left;
  text-decoration: none;
}

.contact:last-child {
  border-bottom: 1px solid #b9c0a3;
}

.contact strong {
  display: block;
  font: italic 29px "Cormorant Garamond", Georgia, serif;
}

.contact small {
  display: block;
  margin-top: 5px;
  font-size: 11px;
}

.contact > span:last-child {
  font-size: 11px;
  white-space: nowrap;
}

footer {
  padding: 60px 20px 75px;
  text-align: center;
  background:
    linear-gradient(#fbfaf4df, #fbfaf499),
    var(--floral) bottom / cover;
}

footer .signature {
  margin: 15px 0;
  font-size: 39px;
}

#heroTitle:focus {
  outline: none;
}

#confetti {
  position: fixed;
  inset: 0;
  z-index: 120;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

@media (max-width: 360px) {
  .section {
    padding-inline: 22px;
  }

  .hero {
    padding-inline: 23px;
  }

  .cover-heading h1 {
    font-size: 47px;
  }

  .cover-footer p {
    font-size: 24px;
  }

  .cover-footer em {
    font-size: 28px;
  }

  .countdown strong {
    font-size: 37px;
  }

  .contact small {
    font-size: 10px;
  }
}

@media (max-height: 650px) {
  .cover-heading {
    top: 14%;
  }

  .cover-heading h1 {
    margin-top: 15px;
    font-size: 43px;
  }

  .cover-footer {
    top: 65%;
  }

  .open-button {
    margin-top: 14px;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation: none !important;
    transition: none !important;
  }
}
/* ИСПРАВЛЕНИЯ ДЛЯ ТЕКУЩЕГО HTML */

html {
  width: 100%;
  overflow-x: hidden;
}

body {
  width: 100%;
  min-width: 0;
  overflow-x: hidden;
  background-color: #f5f1e7;
  background-attachment: scroll;
}

/* В текущем HTML класс называется cover-paper */
#cover .cover-paper {
  position: relative;
  isolation: isolate;
  width: 100%;
  max-width: 580px;
  height: 100%;
  min-height: 0;
  overflow: hidden;

  background-color: #f5f1e7;
  background-image:
    linear-gradient(
      rgba(250, 248, 239, .32),
      rgba(250, 248, 239, .32)
    ),
    var(--floral);
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;

  box-shadow: 0 0 60px rgba(65, 69, 47, .15);
}

/* Верхние надписи */
#cover .cover-top {
  position: absolute;
  top: 18%;
  left: 7%;
  right: 7%;
  z-index: 3;
  text-align: center;

  transition:
    transform 1s ease,
    opacity .6s ease;
}

#cover .cover-top h1 {
  margin: 22px 0 0;
  color: #4e5340;

  font-family:
    "Cormorant Garamond",
    Georgia,
    serif;
  font-size: clamp(46px, 12vw, 68px);
  font-weight: 500;
  font-style: italic;
  line-height: 1.02;
  letter-spacing: -.035em;
}

#cover .cover-top h1 span {
  color: #a0804b;
  font-size: .55em;
}

#cover .cover-date {
  margin-top: 23px;
  color: #555b48;
  font: 18px "Cormorant Garamond", Georgia, serif;
  letter-spacing: .06em;
}

/* Главное: убираем чёрную заливку SVG */
#cover .envelope-lines {
  position: absolute;
  top: 40%;
  left: 0;
  z-index: 3;

  display: block;
  width: 100%;
  height: 18%;
  overflow: visible;
  pointer-events: none;

  transition: opacity .5s ease;
}

#cover .envelope-lines path {
  fill: none !important;
  stroke: #989d80;
  stroke-width: 1.2;
}

#cover .envelope-lines path + path {
  fill: none !important;
  stroke: #fffdf4;
  stroke-width: 1.8;
}

/* Печать */
#cover .seal {
  position: absolute;
  top: 51%;
  left: 50%;
  z-index: 5;

  width: 108px;
  height: 108px;
  margin: 0;

  transform:
    translate(-50%, -50%)
    rotate(-8deg);
}

/* Нижние надписи */
#cover .cover-bottom {
  position: absolute;
  top: 68%;
  left: 8%;
  right: 8%;
  z-index: 3;

  text-align: center;

  transition:
    transform 1s ease,
    opacity .6s ease;
}

#cover .cover-bottom > p {
  margin: 0;
  color: #535744;

  font-family:
    "Cormorant Garamond",
    Georgia,
    serif;
  font-size: 28px;
  font-weight: 400;
  line-height: 1.15;
}

#cover .cover-bottom em {
  font-size: 32px;
}

#cover .open-button {
  display: block;
  margin: 22px auto 0;
}

#cover .cover-bottom > small {
  display: block;
  margin-top: 12px;
  color: #697158;
  font-size: 10px;
}

/* Маленькие заголовки в текущем HTML */
.small-title {
  color: #69745a;
  font-family: Manrope, Arial, sans-serif;
  font-size: 10px;
  font-weight: 500;
  line-height: 1.7;
  letter-spacing: .16em;
  text-transform: uppercase;
}

/* Открытие для фактически используемых классов */
#cover.opening .cover-top {
  transform: translateY(-80px);
  opacity: 0;
}

#cover.opening .cover-bottom {
  transform: translateY(80px);
  opacity: 0;
}

#cover.opening .envelope-lines {
  opacity: 0;
}

#cover.opening .seal {
  transform:
    translate(-50%, -50%)
    rotate(15deg)
    scale(1.35);
  opacity: 0;
}

#heroTitle:focus {
  outline: none;
}

/* Удаляем завитушки */
.ornament,
.svg-defs,
.bouquet {
  display: none !important;
}

/* Небольшие экраны */
@media (max-height: 650px) {
  #cover .cover-top {
    top: 13%;
  }

  #cover .cover-top h1 {
    margin-top: 15px;
    font-size: 44px;
  }

  #cover .cover-date {
    margin-top: 17px;
  }

  #cover .cover-bottom {
    top: 65%;
  }

  #cover .cover-bottom > p {
    font-size: 24px;
  }

  #cover .cover-bottom em {
    font-size: 28px;
  }

  #cover .open-button {
    margin-top: 14px;
  }

  #cover .cover-bottom > small {
    margin-top: 7px;
  }
}

@media (prefers-reduced-motion: reduce) {
  #cover,
  #cover * {
    transition: none !important;
  }
}
/* ТВОЙ ЦВЕТОЧНЫЙ ФОН */
:root {
  --floral: url("https://i.ibb.co/k2xJpR9N/16-ECC231-2303-4-AF9-9-E62-65-DCD2745-AEF.png");
}

/* Фон страницы */
body {
  background-color: #f7f3e9;
  background-image: var(--floral);
  background-position: center top;
  background-size: cover;
  background-repeat: no-repeat;
  background-attachment: scroll;
}

/* Конверт */
#cover .cover-paper,
#cover .envelope,
#cover .envelope-top,
#cover .envelope-bottom {
  background-color: #f7f3e9;
  background-image: var(--floral);
  background-position: center;
  background-size: cover;
  background-repeat: no-repeat;
}

/* Внутренняя страница */
#invitation {
  background-color: #f7f3e9;
  background-image:
    linear-gradient(
      rgba(255, 253, 245, 0.65),
      rgba(255, 253, 245, 0.65)
    ),
    var(--floral);

  background-position: center top;
  background-size: 100% auto;
  background-repeat: repeat-y;
}

/* Первый экран */
#invitation .hero {
  background-image:
    linear-gradient(
      rgba(255, 253, 245, 0.25),
      rgba(255, 253, 245, 0.35)
    ),
    var(--floral);

  background-position: center;
  background-size: cover;
}

/* Нижняя часть */
#invitation footer {
  background-image:
    linear-gradient(
      rgba(255, 253, 245, 0.35),
      rgba(255, 253, 245, 0.25)
    ),
    var(--floral);

  background-position: center bottom;
  background-size: cover;
}
/* ЧИТАЕМОСТЬ ТЕКСТА */
#invitation {
  color: #373e2e;
}

#invitation h2,
#invitation .intro {
  color: #373e2e;
}

/* Надпись «Приглашение на свадьбу» */
#invitation .hero > .small-title,
#invitation .hero > .eyebrow {
  display: table;
  max-width: 100%;
  margin: 0 auto 18px;
  padding: 9px 16px;

  color: #424d35;
  background: rgba(255, 253, 246, 0.96);
  border: 1px solid rgba(120, 133, 100, 0.25);
  border-radius: 3px;

  font-size: 12px;
  font-weight: 500;
  line-height: 1.6;
  letter-spacing: 0.1em;
}

/* Имена на первом экране */
#invitation .hero h1 {
  width: fit-content;
  max-width: 100%;
  margin: 12px auto;
  padding: 12px 18px;

  color: #343d2b;
  background: rgba(255, 253, 246, 0.9);
  border-radius: 3px;

  font-size: clamp(36px, 9vw, 56px);
  line-height: 1.15;
  letter-spacing: -0.025em;

  box-shadow: 0 5px 25px rgba(73, 77, 54, 0.06);
}

#invitation .hero h1 span {
  color: #95713d;
}

/* Подпись под именами */
#invitation .hero-subtitle,
#invitation .hero-note {
  display: table;
  margin: 14px auto 28px;
  padding: 7px 12px;

  color: #46513b;
  background: rgba(255, 253, 246, 0.93);
  border-radius: 3px;

  font-size: 12px;
  line-height: 1.6;
}

/* Дата под фотографией */
#invitation .hero-date {
  display: table;
  margin: 25px auto 8px;
  padding: 8px 16px;

  color: #485338;
  background: rgba(255, 253, 246, 0.93);
  border-radius: 3px;
}

/* Надписи на самом конверте */
#cover .cover-top,
#cover .cover-heading {
  padding: 16px 10px;
  background: rgba(255, 253, 246, 0.88);
  border-radius: 4px;
}

#cover .cover-top .small-title,
#cover .cover-heading .eyebrow {
  color: #414b34;
  font-size: 11px;
  font-weight: 500;
}

#cover .cover-top h1,
#cover .cover-heading h1 {
  color: #343d2b;
}

/* КРУПНЫЕ КНОПКИ ЗВОНКА */
#invitation .contacts {
  padding: 45px 28px;
  background: rgba(245, 247, 235, 0.94);
}

#invitation .contacts h2 {
  color: #37432d;
  font-size: clamp(32px, 8vw, 42px);
}

#invitation .contacts .contact {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 100%;
  max-width: 390px;
  min-height: 58px;
  margin: 16px auto;
  padding: 16px 20px;

  border: 1px solid #687953;
  border-radius: 5px;

  color: #ffffff;
  background: #687953;

  font-family: Manrope, Arial, sans-serif;
  font-size: 16px;
  font-weight: 500;
  line-height: 1.5;
  text-align: center;
  text-decoration: none;

  box-shadow: 0 5px 16px rgba(63, 76, 45, 0.12);
}

#invitation .contacts .contact:hover,
#invitation .contacts .contact:active {
  color: #ffffff;
  background: #52633f;
  border-color: #52633f;
}

#invitation .contacts .contact::before,
#invitation .contacts .contact::after {
  content: none;
}
/* УБИРАЕМ ПОДЛОЖКИ ПОД НАДПИСЯМИ */
#invitation .hero > .small-title,
#invitation .hero > .eyebrow,
#invitation .hero h1,
#invitation .hero-subtitle,
#invitation .hero-note,
#invitation .hero-date,
#cover .cover-top,
#cover .cover-heading {
  background: none !important;
  border: none !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  backdrop-filter: none !important;
}

/* Убираем внутренние отступы бывших плашек */
#invitation .hero > .small-title,
#invitation .hero > .eyebrow,
#invitation .hero h1,
#invitation .hero-subtitle,
#invitation .hero-note,
#invitation .hero-date {
  padding: 0 !important;
}

/* Делаем текст темнее */
#invitation .hero h1,
#cover .cover-top h1,
#cover .cover-heading h1 {
  color: #303a28 !important;
  text-shadow: 0 1px 3px rgba(255, 253, 245, 0.85);
}

#invitation .hero > .small-title,
#invitation .hero > .eyebrow,
#cover .cover-top .small-title,
#cover .cover-heading .eyebrow {
  color: #35412d !important;
  font-size: 12px !important;
  font-weight: 500;
  letter-spacing: 0.09em;
  text-shadow: 0 1px 3px rgba(255, 253, 245, 0.9);
}

#invitation .hero-subtitle,
#invitation .hero-note,
#invitation .hero-date {
  color: #3d4933 !important;
  text-shadow: 0 1px 3px rgba(255, 253, 245, 0.85);
}
/* Текст конверта заканчивается выше печати */
#cover .cover-top {
  position: absolute !important;
  top: 6% !important;
  bottom: calc(49% + 76px) !important;
  left: 7% !important;
  right: 7% !important;

  display: flex !important;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  gap: 14px;

  background: none !important;
  padding: 0 !important;
}

#cover .cover-top h1 {
  margin: 0 !important;
  font-size: clamp(32px, 6vh, 56px) !important;
  line-height: 1.06 !important;
}

#cover .cover-date {
  position: static !important;
  margin: 0 !important;
  color: #343b2d !important;
  font-size: 18px !important;
  line-height: 1.4 !important;
  letter-spacing: 0.08em !important;
}

/* Затемняем весь текст в самом конце */
#invitation footer,
#invitation footer p,
#invitation footer .signature,
#invitation footer small {
  color: #30382a !important;
  opacity: 1 !important;
  text-shadow: 0 1px 3px rgba(255, 253, 247, 0.9);
}

#invitation footer .signature {
  font-weight: 500 !important;
}
